{
  "$comment": "Fuente única de verdad del protocolo Lupus. Si cambias este archivo, los tests del servidor y del cliente fallan hasta que ambos lados se actualicen.",
  "version": 1,
  "envelope": {
    "v": "number",
    "type": "string",
    "id": "string",
    "at": "number"
  },
  "messages": {
    "hello": {
      "direction": "c2s",
      "summary": "El cliente se presenta justo después de abrir la conexión.",
      "fields": {
        "nickname": "string"
      },
      "example": {
        "v": 1,
        "type": "hello",
        "id": "00000000-0000-0000-0000-000000000001",
        "at": 1700000000000,
        "nickname": "Ana"
      }
    },
    "welcome": {
      "direction": "s2c",
      "summary": "Handshake del servidor: asigna el identificador de conexión.",
      "fields": {
        "connectionId": "string",
        "nickname": "string",
        "serverTime": "number"
      },
      "example": {
        "v": 1,
        "type": "welcome",
        "id": "00000000-0000-0000-0000-000000000002",
        "at": 1700000000100,
        "connectionId": "00000000-0000-0000-0000-0000000000aa",
        "nickname": "Ana",
        "serverTime": 1700000000100
      }
    },
    "echo": {
      "direction": "both",
      "summary": "Mensaje de prueba: el servidor devuelve el mismo texto.",
      "fields": {
        "text": "string"
      },
      "example": {
        "v": 1,
        "type": "echo",
        "id": "00000000-0000-0000-0000-000000000003",
        "at": 1700000000200,
        "text": "hola"
      }
    },
    "ping": {
      "direction": "c2s",
      "summary": "Comprobación de vida del cliente. El servidor responde con pong.",
      "fields": {},
      "example": {
        "v": 1,
        "type": "ping",
        "id": "00000000-0000-0000-0000-000000000004",
        "at": 1700000000300
      }
    },
    "pong": {
      "direction": "s2c",
      "summary": "Respuesta a ping.",
      "fields": {},
      "example": {
        "v": 1,
        "type": "pong",
        "id": "00000000-0000-0000-0000-000000000005",
        "at": 1700000000310
      }
    },
    "error": {
      "direction": "s2c",
      "summary": "El servidor rechaza un mensaje y explica por qué.",
      "fields": {
        "code": "string",
        "message": "string"
      },
      "example": {
        "v": 1,
        "type": "error",
        "id": "00000000-0000-0000-0000-000000000006",
        "at": 1700000000400,
        "code": "invalid_message",
        "message": "El mensaje no cumple el contrato del protocolo."
      }
    },
    "create_room": {
      "direction": "c2s",
      "summary": "Crea una sala privada. El creador pasa a ser host.",
      "fields": {
        "nickname": "string"
      },
      "example": {
        "v": 1,
        "type": "create_room",
        "id": "00000000-0000-0000-0000-000000000007",
        "at": 1700000000500,
        "nickname": "Ana"
      }
    },
    "join_room": {
      "direction": "c2s",
      "summary": "Entra en una sala existente con su código.",
      "fields": {
        "roomCode": "string",
        "nickname": "string"
      },
      "example": {
        "v": 1,
        "type": "join_room",
        "id": "00000000-0000-0000-0000-000000000008",
        "at": 1700000000600,
        "roomCode": "ABC234",
        "nickname": "Luis"
      }
    },
    "resume_room": {
      "direction": "c2s",
      "summary": "Recupera el asiento de un jugador usando su identidad persistente (playerId).",
      "fields": {
        "roomCode": "string",
        "playerId": "string"
      },
      "example": {
        "v": 1,
        "type": "resume_room",
        "id": "00000000-0000-0000-0000-000000000019",
        "at": 1700000000650,
        "roomCode": "ABC234",
        "playerId": "00000000-0000-0000-0000-0000000000cc"
      }
    },
    "room_state": {
      "direction": "s2c",
      "summary": "Respuesta a create_room, join_room y resume_room: la sala y quién eres en ella.",
      "fields": {
        "roomCode": "string",
        "playerId": "string",
        "players": "array"
      },
      "example": {
        "v": 1,
        "type": "room_state",
        "id": "00000000-0000-0000-0000-000000000009",
        "at": 1700000000700,
        "roomCode": "ABC234",
        "playerId": "00000000-0000-0000-0000-0000000000bb",
        "players": [
          { "id": "00000000-0000-0000-0000-0000000000bb", "nickname": "Ana", "host": true, "connected": true }
        ]
      }
    },
    "room_updated": {
      "direction": "s2c",
      "summary": "La lista de jugadores de la sala ha cambiado (alta, baja o desconexión).",
      "fields": {
        "roomCode": "string",
        "players": "array"
      },
      "example": {
        "v": 1,
        "type": "room_updated",
        "id": "00000000-0000-0000-0000-000000000010",
        "at": 1700000000800,
        "roomCode": "ABC234",
        "players": [
          { "id": "00000000-0000-0000-0000-0000000000bb", "nickname": "Ana", "host": true, "connected": true },
          { "id": "00000000-0000-0000-0000-0000000000cc", "nickname": "Luis", "host": false, "connected": true }
        ]
      }
    },
    "leave_room": {
      "direction": "c2s",
      "summary": "Salida voluntaria. Si la sala está en el lobby y sale el host, la sala se cierra.",
      "fields": {},
      "example": {
        "v": 1,
        "type": "leave_room",
        "id": "00000000-0000-0000-0000-000000000011",
        "at": 1700000000900
      }
    },
    "kick_player": {
      "direction": "c2s",
      "summary": "El host expulsa a un jugador de la sala.",
      "fields": {
        "playerId": "string"
      },
      "example": {
        "v": 1,
        "type": "kick_player",
        "id": "00000000-0000-0000-0000-000000000012",
        "at": 1700000001000,
        "playerId": "00000000-0000-0000-0000-0000000000cc"
      }
    },
    "room_closed": {
      "direction": "s2c",
      "summary": "La sala se ha cerrado; el jugador deja de pertenecer a ella.",
      "fields": {
        "roomCode": "string",
        "reason": "string"
      },
      "example": {
        "v": 1,
        "type": "room_closed",
        "id": "00000000-0000-0000-0000-000000000013",
        "at": 1700000001100,
        "roomCode": "ABC234",
        "reason": "host_left"
      }
    },
    "kicked": {
      "direction": "s2c",
      "summary": "El host ha expulsado a este jugador de la sala.",
      "fields": {
        "roomCode": "string"
      },
      "example": {
        "v": 1,
        "type": "kicked",
        "id": "00000000-0000-0000-0000-000000000014",
        "at": 1700000001200,
        "roomCode": "ABC234"
      }
    },
    "update_settings": {
      "direction": "c2s",
      "summary": "El host cambia la configuración de la partida.",
      "fields": {
        "wolves": "number",
        "roles": "array",
        "lives": "number",
        "president": "boolean",
        "debateSeconds": "number",
        "roleSeconds": "number",
        "voteSeconds": "number",
        "showVoteDetail": "boolean"
      },
      "example": {
        "v": 1,
        "type": "update_settings",
        "id": "00000000-0000-0000-0000-000000000015",
        "at": 1700000001300,
        "wolves": 2,
        "roles": ["seer", "witch"],
        "lives": 1,
        "president": false,
        "debateSeconds": 240,
        "roleSeconds": 20,
        "voteSeconds": 45,
        "showVoteDetail": true
      }
    },
    "room_settings": {
      "direction": "s2c",
      "summary": "Configuración vigente de la sala; se envía al crear, al entrar y al cambiarla.",
      "fields": {
        "roomCode": "string",
        "wolves": "number",
        "roles": "array",
        "lives": "number",
        "president": "boolean",
        "debateSeconds": "number",
        "roleSeconds": "number",
        "voteSeconds": "number",
        "showVoteDetail": "boolean"
      },
      "example": {
        "v": 1,
        "type": "room_settings",
        "id": "00000000-0000-0000-0000-000000000016",
        "at": 1700000001400,
        "roomCode": "ABC234",
        "wolves": 2,
        "roles": ["seer", "witch"],
        "lives": 1,
        "president": false,
        "debateSeconds": 240,
        "roleSeconds": 20,
        "voteSeconds": 45,
        "showVoteDetail": true
      }
    },
    "start_game": {
      "direction": "c2s",
      "summary": "El host arranca la partida cuando hay al menos 5 jugadores.",
      "fields": {},
      "example": {
        "v": 1,
        "type": "start_game",
        "id": "00000000-0000-0000-0000-000000000017",
        "at": 1700000001500
      }
    },
    "game_starting": {
      "direction": "s2c",
      "summary": "La partida empieza; el lobby deja paso al juego.",
      "fields": {
        "roomCode": "string"
      },
      "example": {
        "v": 1,
        "type": "game_starting",
        "id": "00000000-0000-0000-0000-000000000018",
        "at": 1700000001600,
        "roomCode": "ABC234"
      }
    }
  }
}
